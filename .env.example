# Copy to .env and configure values for your environment.
PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:8443
VITE_DATA_MODE=api
JWT_SECRET=replace-with-a-long-random-secret-before-use
JWT_EXPIRES_IN=8h
DATABASE_URL=postgres://trooi:change-me@127.0.0.1:5432/trooi
MONGODB_URI=mongodb://127.0.0.1:27017/trooi
# Used only by pnpm db:seed. Set a different value outside local development.
SEED_PASSWORD=replace-with-a-seed-password-at-least-12-characters

# --- CẤU HÌNH GỬI EMAIL XÁC THỰC OTP ---
# 1. Gửi qua HTTPS API (Khuyên dùng khi deploy lên Render / Vercel vì cloud chặn cổng SMTP 587/465):
# Brevo (300 email/ngày miễn phí, gửi được tới mọi hòm thư):
# Đăng ký tại brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=lightning09512@gmail.com
BREVO_SENDER_NAME="Trọ Ơi"

# Hoặc Resend API (3000 email/tháng miễn phí tại resend.com):
RESEND_API_KEY=
RESEND_FROM="Trọ Ơi <onboarding@resend.dev>"

# 2. Gửi qua SMTP truyền thống (Dùng khi chạy localhost máy tính cá nhân hoặc VPS):
# Gmail: smtp.gmail.com, port 587, secure=false; dùng Mật khẩu ứng dụng Google (App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Trọ Ơi <lightning09512@gmail.com>"

# Optional media hosting. Development falls back to ignored local files in server/uploads/.
# Production requires Cloudinary because local server disks may be temporary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
